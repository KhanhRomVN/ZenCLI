{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",

    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node", "bun-types"],
    "jsx": "react-jsx",
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "baseUrl": ".",
    "paths": {
      "src/*": ["temp/claude-code/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "temp", "dist", "temp/claude-code/src/webview-ui"]
}
